// DevDNA SoftwareDNA — data model.
//
// Two principles drive this schema:
//
//  1. Multi-tenancy is structural. Every row a shop can read carries an
//     organizationId, and every query path filters on it. Repair shops compete
//     with each other and trade the same stock; a cross-tenant leak of device
//     history is an existential product failure, not a bug.
//
//  2. Inspections are immutable evidence. The raw snapshot is stored verbatim
//     alongside the scored result and the engine version that produced it, so
//     any historical report can be explained, re-scored under a newer engine,
//     or defended in a dispute between trading partners.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  TECHNICIAN
  VIEWER
}

enum InspectionStatus {
  PENDING
  COMPLETE
  FAILED
}

enum TrustVerdict {
  TRUSTED
  TRUSTED_WITH_NOTES
  CAUTION
  UNTRUSTED
  INSUFFICIENT_EVIDENCE
}

enum ModuleId {
  IDENTITY
  HARDWARE_CONSISTENCY
  SERVICE_EVIDENCE
  BATTERY_INTELLIGENCE
  SECURITY_DNA
  TRUST
}

enum Determinacy {
  DETERMINED
  INDETERMINATE
}

enum FindingBasis {
  EVIDENCE
  ABSENCE
}

/// Subjects an evidence record or verdict can be about.
enum EvidenceSubject {
  DEVICE
  SYSTEM_SOFTWARE
  SECURITY_STATE
  BATTERY
  DISPLAY
  REAR_CAMERA
  FRONT_CAMERA
  FACE_ID
  TOUCH_ID
  LOGIC_BOARD
  REAR_HOUSING
  LIDAR
  SPEAKER
  MICROPHONE
  TAPTIC_ENGINE
}

/// The Service Evidence Engine's entire vocabulary. Deliberately three values:
/// it reports whether a component was replaced, never whether a repair
/// "happened" in some looser sense, and never invents a fourth hedge.
enum ServiceVerdict {
  ORIGINAL_LIKELY
  REPLACED_LIKELY
  CANNOT_DETERMINE
}

/// Authenticity of a fitted part. Orthogonal to whether it was replaced, and
/// stored separately for exactly that reason.
enum PartAuthenticity {
  GENUINE_APPLE
  GENUINE_TRANSPLANTED
  NOT_VERIFIED
  UNKNOWN
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("trial")
  /// Per-tenant salt for hashing UDIDs and serials. Without it the same
  /// handset would hash identically across tenants, letting one shop confirm
  /// another shop handled a specific device.
  identifierSalt String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  bridges     BridgeRegistration[]
  devices     Device[]
  inspections Inspection[]
  reports     Report[]
  customers   Customer[]
  auditLogs   AuditLog[]
  apiKeys     ApiKey[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String
  name           String
  role           UserRole @default(TECHNICIAN)
  lastLoginAt    DateTime?
  disabledAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspections  Inspection[]
  sessions     RefreshToken[]

  @@unique([email])
  @@index([organizationId])
  @@map("users")
}

/// Refresh tokens are stored hashed and individually revocable, so signing out
/// one shop laptop does not require rotating the whole tenant's secrets.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// One physical workstation running DevDNA Bridge.
model BridgeRegistration {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  workstation    String?
  platform       String?
  version        String?
  /// The pairing token is stored as a hash — the API only ever compares it.
  tokenHash      String   @unique
  /// The HMAC secret must be recoverable to verify a signature, so it is
  /// encrypted at rest with the application key rather than hashed. A database
  /// leak alone therefore does not yield forgeable bridge credentials.
  secretCiphertext String
  lastSeenAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspections  Inspection[]
  nonces       BridgeNonce[]

  @@index([organizationId])
  @@map("bridge_registrations")
}

/// Replay protection for signed bridge requests. Rows are short-lived and
/// swept by a scheduled job.
model BridgeNonce {
  id        String   @id @default(cuid())
  bridgeId  String
  nonce     String
  expiresAt DateTime

  bridge BridgeRegistration @relation(fields: [bridgeId], references: [id], onDelete: Cascade)

  @@unique([bridgeId, nonce])
  @@index([expiresAt])
  @@map("bridge_nonces")
}

/// A handset, identified by a salted hash rather than its raw UDID.
model Device {
  id             String   @id @default(cuid())
  organizationId String
  udidHash       String
  serialHash     String?
  /// Retained only when the organization has opted in to plaintext identifiers.
  udid           String?
  serialNumber   String?
  productType    String
  marketingName  String
  capacityGb     Int?
  regionCode     String?
  regionName     String?
  colorHint      String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  inspectionCount Int     @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspections  Inspection[]

  @@unique([organizationId, udidHash])
  @@index([organizationId, lastSeenAt])
  @@map("devices")
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  reference      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspections  Inspection[]

  @@index([organizationId])
  @@map("customers")
}

/// One inspection.
///
/// The row carries the *conclusions* and the summary fields queries need. The
/// *evidence* lives in its own table, and the two are deliberately not mixed:
/// a conclusion can always be traced back to rows in `evidence_records`, and
/// the evidence can be re-scored without the conclusions being in the way.
model Inspection {
  id             String   @id @default(cuid())
  organizationId String
  deviceId       String
  userId         String?
  bridgeId       String?
  customerId     String?

  status InspectionStatus @default(COMPLETE)

  // --- Trust Engine output -------------------------------------------------
  trustVerdict  TrustVerdict
  trustScore    Int
  /// Score before gates, so a report can show what the caps cost.
  rawTrustScore Int
  confidence    Float
  /// Share of the assessable picture that was actually established.
  coverage      Float

  // --- Module verdict summaries, denormalised for filtering ---------------
  identityVerdict String?
  hardwareVerdict String?
  securityVerdict String?
  batteryVerdict  String?

  // --- Headline facts a list view needs without opening the JSON ----------
  batteryHealthPercent      Int?
  batteryCycleCount         Int?
  batteryWearGrade          String?
  batteryReplacementRisk    Float?
  securityPostureScore      Int?
  hardwareAnomalyCount      Int      @default(0)
  componentsReplacedCount   Int      @default(0)
  componentsIndeterminate   Int      @default(0)
  iosVersion                String?
  buildVersion              String?
  unitProvenance            String?

  engineVersion    String
  algorithmVersion String
  /// Digest of the evidence ledger this inspection was computed from. Lets a
  /// stored ledger be proven unmodified before it is re-scored.
  ledgerDigest     String

  /// The verbatim bridge capture. Kept for forensic re-collection only; the
  /// ledger, not this, is what re-scoring reads.
  snapshot Json
  /// Module details and the trust assessment, as rendered at inspection time.
  report   Json

  capturedAt DateTime
  createdAt  DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  bridge       BridgeRegistration? @relation(fields: [bridgeId], references: [id], onDelete: SetNull)
  customer     Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)

  evidence     EvidenceRecordRow[]
  inferences   InferenceRow[]
  verdicts     ModuleVerdictRow[]
  components   ComponentServiceRow[]
  findings     FindingRecord[]
  auditEntries AuditEntryRow[]
  reports      Report[]

  @@index([organizationId, createdAt])
  @@index([organizationId, trustVerdict])
  @@index([deviceId, createdAt])
  @@map("inspections")
}

/// An observed fact, with its provenance. Never a conclusion.
///
/// Stored as rows rather than inside the report JSON so that evidence is
/// queryable in its own right: "every device this month where the diagnostics
/// relay refused" is the question a refurbisher actually asks, and it should be
/// plain SQL.
model EvidenceRecordRow {
  id           String @id @default(cuid())
  inspectionId String
  /// Content-addressed id from the engine (`ev_...`). Unique per inspection.
  evidenceId   String

  kind    String
  subject EvidenceSubject
  key     String
  /// Preserved with its original type rather than stringified, so re-scoring a
  /// stored ledger reproduces the original result exactly.
  value   Json

  // --- Provenance: required on every record --------------------------------
  sourceAuthority String
  method          String
  collector       String
  observedAt      DateTime
  reliability     Float
  instrument      String?

  /// Verbatim excerpt that produced this record.
  raw  String?
  note String?

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, evidenceId])
  @@index([inspectionId, subject])
  @@index([key])
  @@index([sourceAuthority, method])
  @@map("evidence_records")
}

/// A derived claim. Cites evidence by id; never stands alone.
model InferenceRow {
  id           String @id @default(cuid())
  inspectionId String
  inferenceId  String

  module     ModuleId
  rule       String
  subject    EvidenceSubject
  direction  String
  statement  String
  weight     Float
  confidence Float
  /// Content-addressed evidence ids this inference rests on. Never empty.
  evidenceIds String[]
  derivedAt   DateTime

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, inferenceId])
  @@index([inspectionId, module])
  @@index([rule])
  @@map("inferences")
}

/// A module's conclusion about one subject. Cites the inferences behind it.
model ModuleVerdictRow {
  id           String @id @default(cuid())
  inspectionId String
  verdictId    String

  module      ModuleId
  subject     EvidenceSubject
  value       String
  determinacy Determinacy
  confidence  Float
  rationale   String
  inferenceIds String[]
  evidenceIds  String[]

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, verdictId])
  @@index([inspectionId, module])
  @@index([module, value])
  @@map("module_verdicts")
}

/// Per-component service outcome, denormalised so fleet analytics are plain
/// SQL: "how many third-party displays did we see this month" should not need
/// a JSON traversal.
model ComponentServiceRow {
  id           String @id @default(cuid())
  inspectionId String

  subject      EvidenceSubject
  verdict      ServiceVerdict
  authenticity PartAuthenticity
  confidence   Float
  rationale    String

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([subject, verdict])
  @@index([subject, authenticity])
  @@map("component_service_results")
}

/// One step of how a report was produced, in order. Replayable.
model AuditEntryRow {
  id           String @id @default(cuid())
  inspectionId String

  sequence Int
  at       DateTime
  module   String
  action   String
  summary  String
  refs     Json

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, sequence])
  @@index([inspectionId, sequence])
  @@map("audit_entries")
}

/// A machine-readable finding.
///
/// Findings are conclusions too, so they cite their support. `basis` records
/// whether that support is named evidence or a verifiable absence: some of the
/// most important findings - "no attestation captured", "coverage too low" -
/// are claims about what the ledger lacks and can cite nothing by
/// construction. Modelling that explicitly keeps "unsupported" and "about
/// absence" from being confused.
model FindingRecord {
  id           String   @id @default(cuid())
  inspectionId String
  code         String
  severity     Severity
  module       ModuleId
  title        String
  detail       String
  basis        FindingBasis
  evidenceIds  String[]
  inferenceIds String[]

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([code])
  @@index([module, severity])
  @@map("findings")
}

model Report {
  id             String   @id @default(cuid())
  organizationId String
  inspectionId   String
  /// Short unguessable id embedded in the QR code and public verify URL.
  publicId       String   @unique
  format         String   @default("pdf")
  storageKey     String
  /// SHA-256 of the generated file, so a shared PDF can be proven unaltered.
  checksum       String
  sizeBytes      Int
  downloadCount  Int      @default(0)
  expiresAt      DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspection   Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("reports")
}

model ApiKey {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  keyHash        String   @unique
  prefix         String
  scopes         String[]
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

/// Append-only audit trail. Inspections underwrite commercial decisions, so
/// who ran what, from where, and when has to be answerable months later.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorType      String
  actorId        String?
  action         String
  entity         String
  entityId       String?
  ip             String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([action])
  @@map("audit_logs")
}
