# ---------------------------------------------------------------------------
# DevDNA SoftwareDNA — environment reference
# Copy to .env and fill in. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# --- API ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://devdna:devdna@localhost:5432/devdna?schema=public

# Generate with: openssl rand -base64 48
# The API refuses to boot in production if these are left at their defaults.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Encrypts bridge HMAC secrets at rest (AES-256-GCM). In production this comes
# from AWS Secrets Manager / KMS, never from a file on the instance.
ENCRYPTION_KEY=change-me-as-well

CORS_ORIGINS=http://localhost:3000
PUBLIC_VERIFY_BASE_URL=http://localhost:3000/verify
REPORT_STORAGE_DIR=.data/reports
BRIDGE_SKEW_SECONDS=300

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY — disables authentication entirely.
#
# When true: every API route accepts an injected fake principal
# (test@devdna.local / ADMIN / workspace devdna-demo-2026), the dashboard
# renders with no session, and the sign-in screen is unreachable.
#
# The API REFUSES TO BOOT if this is true while NODE_ENV=production. The web app
# ignores it in production and keeps requiring a login. Set it in your local
# .env only; never in a deployed environment, and never in CI that runs against
# shared data.
#
# Both apps read the same variable, so set it once for the API and once for the
# web process if you run them with separate environments.
#
# Works with `pnpm dev`. It intentionally does NOT work through
# `next build && next start`: that sets NODE_ENV=production, and Next.js also
# inlines the variable into the middleware bundle at build time. Both effects
# leave authentication ON, which is the correct direction for a production
# build to fail.
#
# Seed the matching workspace with:  DEV_AUTH_BYPASS=true pnpm seed
DEV_AUTH_BYPASS=false

# Persist raw UDIDs and serial numbers rather than salted hashes only.
# Off by default: leave it off unless a tenant has a documented legal basis.
RETAIN_PLAINTEXT_IDENTIFIERS=false

# --- Web ---
DEVDNA_API_URL=http://localhost:4000

# --- Bridge (runs on the technician's laptop, not on a server) ---
DEVDNA_BRIDGE_PORT=7411
DEVDNA_ALLOWED_ORIGINS=http://localhost:3000
DEVDNA_API_URL_BRIDGE=http://localhost:4000
# Issued once when a workstation is paired in the dashboard.
DEVDNA_BRIDGE_TOKEN=
DEVDNA_BRIDGE_SECRET=
DEVDNA_SIMULATOR=false
DEVDNA_COLLECT_ANALYTICS=true
